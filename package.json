{
    "name":  "dsh-verify-guard",
    "version":  "0.1.1",
    "private":  true,
    "type":  "module",
    "description":  "Detects project working directories and injects a verification reminder before the agent claims work is done.",
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            }
}
